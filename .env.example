# MONGO_URI=replace_with_your_mongodb_connection_string
# PORT=5000
# # Optional comma-separated DNS server IPs when Node cannot resolve the MongoDB SRV record.
# # Prefer the DNS servers provided by your hosting platform in production.
# DNS_SERVERS=
# # Comma-separated exact browser origins, for example http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
# # Generate a long random secret; keep it server-side and never put it in frontend code.
# USER_API_KEY=replace_with_a_long_random_secret
