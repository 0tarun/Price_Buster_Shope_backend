MONGO_URI=replace_with_your_mongodb_connection_string
PORT=5000
NODE_ENV=development
# Optional comma-separated DNS server IPs when Node cannot resolve the MongoDB SRV record.
# Prefer the DNS servers provided by your hosting platform in production.
DNS_SERVERS=
# Comma-separated exact browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Use "none" only for an HTTPS frontend hosted on a different site from the API.
AUTH_COOKIE_SAME_SITE=lax
# Required for the admin dashboard; use a long, unique random value.
ADMIN_API_KEY=replace_with_a_long_random_admin_key
# Cloudinary server-side credentials. Keep these out of the frontend environment.
CLOUDINARY_CLOUD_NAME=replace_with_cloud_name
CLOUDINARY_API_KEY=replace_with_api_key
CLOUDINARY_API_SECRET=replace_with_api_secret
